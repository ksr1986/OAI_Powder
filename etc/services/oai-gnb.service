[Unit]
Description=OAI gNB
After=network.target

[Service]
Type=simple
Environment=HOME=/root
Restart=always
RestartSec=1
ExecStart=/local/openairinterface5g/cmake_targets/ran_build/build/nr-softmodem -O ~/Desktop/Test_OAI//etc/oai/gnb.sa.band78.106prb.fhi72.4x2.DDDSU.RAN650.conf
StandardOutput=truncate:/var/log/gnb-stdout.log
StandardError=truncate:/var/log/gnb-stdout.log

[Install]
WantedBy=multi-user.target